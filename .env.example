# Optional standard Chat Completions service. Copy to .env.local for local
# web/MCP/predict:reset entry points. Explicit process environment takes priority.
# Claude Haiku 5.5 via Anthropic's official compatibility endpoint:
USAGE_PLANNER_LLM_MODEL=claude-haiku-5-5
USAGE_PLANNER_LLM_BASE_URL=https://api.anthropic.com/v1
USAGE_PLANNER_LLM_API_KEY=
# Installed MCPs can point USAGE_PLANNER_ENV_FILE at a private local file.
# Never bundle that file or expose the API key to the browser.

# Optional official X public timeline (keeps replies, excludes retweets).
# Without it, public source-linked reset records and reposted evidence work.
USAGE_PLANNER_X_BEARER_TOKEN=

# Minutes the web server reuses one reset-evidence crawl (default 30).
USAGE_PLANNER_EVIDENCE_TTL_MINUTES=

# Public deployment origin for canonical URLs, social previews and sitemap.
# Set the actual HTTPS domain, without a path. Unset previews use noindex.
PUBLIC_SITE_URL=
