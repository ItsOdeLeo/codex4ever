{
  "name": "usage-planner",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "A local Codex quota and reset planner with extra reset forecasts, banked reset planning, a web UI, CLI, and MCP server.",
  "license": "MIT",
  "author": "ItsOdeLeo (https://x.com/ItsOdeLeo)",
  "homepage": "https://usageplanner.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsOdeLeo/usage-planner.git"
  },
  "bugs": {
    "url": "https://github.com/ItsOdeLeo/usage-planner/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/cli.js",
    "mcp": "node src/mcp-server.js",
    "plugin:build": "node scripts/build-plugin.mjs",
    "npm:build": "npm run plugin:build && node scripts/build-npm.mjs",
    "site:build": "node scripts/build-site.mjs",
    "web": "node scripts/serve.mjs",
    "backtest:public": "node scripts/backtest-public.mjs",
    "archive:refresh": "node scripts/refresh-archive.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "predict:reset": "node scripts/predict-reset.mjs",
    "alert:demo": "node scripts/alert-demo.mjs",
    "alert:stage": "node scripts/alert-stage.mjs",
    "test": "node --test test/*.test.mjs",
    "test:pace": "node --test test/selected-pace-regression.test.mjs test/web-intensity.test.mjs test/mcp.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
